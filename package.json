    "pages:deploy": "next build && wrangler pages deploy out --project-name knockknock-homepage"
  },
  "dependencies": {
    "next": "15.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0-beta.7",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "tailwindcss": "^4.0.0-beta.7",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
